# phorse -- Caddy config. Copy to /etc/caddy/Caddyfile, then replace
# REPLACE_ME with your domain. Caddy gets the HTTPS
# certificate for the domain by itself.
#
# One origin for everything: the static site at /, the Flask API at /api/*.
# No site password: signing up needs an invite code instead
# (HORSE_REQUIRE_INVITE, python -m server.invites).

REPLACE_ME.example.com {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /srv/phorse/web/build
		# Single-page app: unknown paths get index.html and the client
		# router picks the page.
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/phorse.log
	}
}
