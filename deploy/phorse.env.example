# phorse server environment. Copy to /etc/phorse/phorse.env (readable by
# root and the phorse user only -- it holds the JWT secret). Every other
# HORSE_* knob is in server/config.py and keeps its default unless set here.

# Signs login tokens. Required: gunicorn refuses to start without 32+ chars.
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
HORSE_SECRET_KEY=

# Your domain, with https://. Also the start of the invite links
# `python -m server.invites` prints. The site and API share one origin, so
# for CORS this only matters if something calls the API from elsewhere.
HORSE_CORS_ORIGINS=https://REPLACE_ME.example.com

# Signing up needs an invite code (python -m server.invites). This is the
# default anyway -- set to 0 only if you want anyone to be able to sign up.
HORSE_REQUIRE_INVITE=1

# Retrain every 10 minutes (the default).
HORSE_RETRAIN_INTERVAL=600

# Front-page ("new") feed: the horses you haven't rated yet, ranked by
# contested (most divisive) or consensus (most horse). /ranked always
# lists every horse, most horse first.
HORSE_FEED_STRATEGY=contested
