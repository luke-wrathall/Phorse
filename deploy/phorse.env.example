# phorse server environment. Copy to /etc/phorse/phorse.env (readable by
# root and the phorse user only -- it holds the JWT secret). Every other
# HORSE_* knob is in server/config.py and keeps its default unless set here.

# Signs login tokens. Required: gunicorn refuses to start without 32+ chars.
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
HORSE_SECRET_KEY=

# Your domain, with https://. The site and API share one origin, so this
# only matters if something ever calls the API from elsewhere.
HORSE_CORS_ORIGINS=https://REPLACE_ME.example.com

# Retrain every 10 minutes (the default).
HORSE_RETRAIN_INTERVAL=600
